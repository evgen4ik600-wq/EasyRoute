#!/bin/sh
[ -n "${INTERFACE:-}" ] || exit 0
[ -x /usr/libexec/easyroute ] || exit 0

wanted=0
proto="$(uci -q get "network.$INTERFACE.proto" 2>/dev/null || true)"
[ "$proto" = 'amneziawg' ] && wanted=1

if [ "$wanted" = 0 ]; then
    configured="$(uci -q get easyroute.main.interface 2>/dev/null || true)"
    [ -n "$configured" ] && [ "$INTERFACE" = "$configured" ] && wanted=1
fi

if [ "$wanted" = 0 ]; then
    for id in $(uci show easyroute 2>/dev/null | sed -n "s/^easyroute\.\([^.=]*\)=vpn$/\1/p"); do
        iface="$(uci -q get "easyroute.$id.interface" 2>/dev/null || true)"
        [ "$INTERFACE" = "$iface" ] && { wanted=1; break; }
    done
fi

[ "$wanted" = 1 ] || exit 0

case "${ACTION:-}" in
    ifup|ifupdate|ifdown)
        [ -x /usr/libexec/easyroute-vpn-sync ] && /usr/libexec/easyroute-vpn-sync >/dev/null 2>&1 || true
        /usr/libexec/easyroute apply >/tmp/easyroute-hotplug.log 2>&1 || true
        ;;
esac
